DROP TABLE t;
CREATE VIEW v WITH (security_invoker = TRUE) AS SELECT 1 AS one;
DROP TABLE IF EXISTS u;
DROP VIEW v;
CREATE TOPIC events (CONSUMER reader) WITH (min_active_partitions = 1);
ALTER TOPIC events ADD CONSUMER other;
DROP TOPIC events;
ALTER SEQUENCE `t/_serial_column_id` RESTART WITH 10;
CREATE ASYNC REPLICATION r FOR `/remote/a` AS `a` WITH (CONNECTION_STRING = "grpc://h:2135/?database=/remote");
DROP ASYNC REPLICATION r CASCADE;
CREATE USER alice PASSWORD 'secret';
ALTER GROUP admins ADD USER alice;
DROP USER alice;
CREATE EXTERNAL DATA SOURCE s WITH (SOURCE_TYPE = "ObjectStorage", LOCATION = "https://s3/b", AUTH_METHOD = "NONE");
CREATE OBJECT token (TYPE SECRET) WITH (value = "x");
DROP RESOURCE POOL CLASSIFIER c;
DROP RESOURCE POOL p;
CREATE BACKUP COLLECTION nightly (TABLE `t`) WITH (STORAGE = 'cluster');
DROP COORDINATION NODE locks;
