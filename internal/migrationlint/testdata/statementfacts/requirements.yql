CREATE TABLE t (id Uint64 NOT NULL, v Utf8, PRIMARY KEY (id));
ALTER TABLE t ADD INDEX t_v GLOBAL UNIQUE ON (v);
ALTER TABLE t ADD COLUMN a Int64 DEFAULT 7;
ALTER TABLE t ADD COLUMN b Int64 NOT NULL DEFAULT 0, ADD INDEX t_b GLOBAL UNIQUE SYNC ON (b), ADD COLUMN c Utf8;
ALTER TABLE t ADD COLUMN d Utf8, DROP COLUMN c;
ALTER TABLE t RENAME TO t2;
ALTER TABLE t2 SET (TTL = Interval("P1D") ON a);
ALTER TABLE t2 ADD CHANGEFEED feed WITH (FORMAT = 'JSON', MODE = 'UPDATES');
