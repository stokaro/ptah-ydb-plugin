CREATE TRANSFER tr FROM src TO dst USING ($msg) -> { RETURN [<| id: 1 |>]; };
ALTER TRANSFER tr SET (BATCH_SIZE_BYTES = 1048576);
DROP TRANSFER tr;
CREATE SECRET s WITH (value = "x");
DROP SECRET s;
CREATE STREAMING QUERY q AS DO BEGIN INSERT INTO a SELECT * FROM b; END DO;
ALTER STREAMING QUERY q SET (RUN = FALSE);
DROP STREAMING QUERY q;
